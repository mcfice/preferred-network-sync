#!/usr/bin/env bash

# name of the preferred wifi connection (as in NetworkManager)
PREFERRED=$1

DEBUG=false
for arg in "$@"; do
    if [ "$arg" = '-v' ]; then
        DEBUG=true
    fi
    # Checks for either '-yad' based on your request
    if [ "$arg" = '-yad' ] || [ "$arg" = '-yad' ]; then
        USE_YAD=true
    fi
    # Checks for '-kde' to determine if KDE Connect should be refreshed
    if [ "$arg" = '-kde' ]; then
        RUN_KDE=true
    fi
done

if [ "$USE_YAD" = true ]; then
    echo "Using YAD for notifications."
else
    echo "Using Zenity for notifications."
fi

dbg() {
    if [ "$DEBUG" = true ]; then
        echo "$1"
    fi
}

show_network_popup() {
    # $1 represents the first argument passed to the function
    local PREFERRED_NET="$1"
    local TITLE="$2"
    local MESSAGE="$3"
    local TYPE="${4:-info}" # Default dialog type to 'info' if not passed

    if ([ "$USE_YAD" = true ]); then

        local IMAGE="checkbox"
        if [ "$TYPE" = "error" ]; then IMAGE="dialog-error"; fi
        if [ "$TYPE" = "warning" ]; then IMAGE="dialog-warning"; fi

        yad --info \
        --title="Preferred network script" \
        --image="$IMAGE" \
        --window-icon="network-wireless" \
        --text='<span font="Sans Bold 15" foreground="#2196F3">'$TITLE'</span>\n\n<span font="Sans 12">'"$MESSAGE"'<b>'"$PREFERRED_NET"'</b></span>' \
        --text-align=center \
        --no-buttons \
        --timeout=2 \
        --width=450 \
        --height=120 \
        --fixed \
        --center

    else
        if [ "$TYPE" = "error" ]; then
            zenity --error --title="$TITLE" --text="$MESSAGE$PREFERRED_NET" --timeout=10
        elif [ "$TYPE" = "warning" ]; then
            zenity --warning --title="$TITLE" --text="$MESSAGE$PREFERRED_NET" --timeout=2
        else
            zenity --info --icon-name="checkbox" --title="$TITLE" --text="$MESSAGE$PREFERRED_NET" --timeout=2
        fi
    fi
}

start_loading_popup() {
    local MSG="$1"
    if [ "$USE_YAD" = true ]; then
        yad --progress \
            --title="Preferred network script" \
            --window-icon="network-wireless" \
            --text='<span font="Sans Bold 15" foreground="#2196F3">Connecting...</span>\n\n<span font="Sans 12">'"$MSG"'</span>' \
            --text-align=center \
            --pulsate \
            --timeout=30 \
            --width=450 \
            --height=100 \
            --no-buttons \
            --fixed \
            --percentage=100 \
            --center &
    else
        zenity --progress \
            --title="Network" \
            --text="Connecting to $MSG..." \
            --pulsate \
            --no-cancel \
            --timeout=30 \
            --width=350 &
    fi
}

#RUN KDE RESET LOGIC IF THE FLAG WAS FOUND

if [ "$RUN_KDE" = true ]; then
    dbg "Killing all kdeconnectd processes..."

    if killall kdeconnectd 2>/dev/null; then
        dbg "Successfully killed old kdeconnectd processes."
    else
        dbg "No running kdeconnectd processes found to kill (or kill failed)."
    fi

    if kdeconnect-cli --refresh 2>/dev/null; then
        dbg "KDE Connect refresh signal sent successfully!"
    else
        dbg "ERROR: Failed to execute KDE Connect refresh."
    fi
fi

# 1. CHECK IF ALREADY CONNECTED
if ! nmcli -g NAME con show --active | grep -Fxq "$PREFERRED"; then
    
    dbg "Not connected to $PREFERRED. Checking if available..."

    # 2. CHECK IF AVAILABLE IN RANGE
    if nmcli -g SSID device wifi list | grep -Fxq "$PREFERRED"; then
        
        dbg "$PREFERRED is available. Attempting to connect..."

        REAL_USER=$(who | grep ":0" | head -1 | awk '{print $1}')

        LOADING_PID=""
        if [ -n "$REAL_USER" ]; then
            start_loading_popup "$PREFERRED"    #----loading animation
            LOADING_PID=$!
        fi    

        # 3. ATTEMPT TO CONNECT
        if nmcli c u "$PREFERRED"; then

            if [ -n "$LOADING_PID" ]; then
                kill "$LOADING_PID" 2>/dev/null || true
                wait "$LOADING_PID" 2>/dev/null || true
                sleep 0.15
            fi

            dbg "Connection successful!"
            REAL_USER=$(who | grep ":0" | head -1 | awk '{print $1}')
            if [ -n "$REAL_USER" ]; then 
                show_network_popup "$PREFERRED" "Network" "Connected successfully to " "info"
                #zenity --info --icon-name="checkbox" --title="Network" --text="Connected successfully to $PREFERRED" --timeout=2
                runuser -l "$REAL_USER" -c "kdeconnect-cli --refresh"
            fi
            
        else
            if [ -n "$LOADING_PID" ]; then
                kill "$LOADING_PID" 2>/dev/null || true
                wait "$LOADING_PID" 2>/dev/null || true
                sleep 0.15
            fi

            dbg "Connection attempt failed for unknown reason."
            REAL_USER=$(who | grep ":0" | head -1 | awk '{print $1}')
            if [ -n "$REAL_USER" ]; then 
                show_network_popup "$PREFERRED" "Network" "Failed to connect to " "error"
                #zenity --error --title="Network" --text="Failed to connect to $PREFERRED" --timeout=10
            fi

        fi
    else
        dbg "$PREFERRED not in range. Doing nothing."

        REAL_USER=$(who | grep ":0" | head -1 | awk '{print $1}')
        if [ -n "$REAL_USER" ]; then 
            show_network_popup "$PREFERRED" "Network" "The following is not in range: " "warning"
            #zenity --warning --title="Network" --text="$PREFERRED is not in range" --timeout=2
        fi

    fi
else
    dbg "Already connected to $PREFERRED. Doing nothing."

    REAL_USER=$(who | grep ":0" | head -1 | awk '{print $1}')
    if [ -n "$REAL_USER" ]; then 
        show_network_popup "$PREFERRED" "Network" "Already connected to " "info"
        #zenity --info --icon-name="checkbox" --title="Network" --text="Already connected to $PREFERRED" --timeout=1
    fi

fi

sleep 1
